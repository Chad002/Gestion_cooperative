<?xml version="1.0" encoding="UTF-8"?>
<web-app version="4.0" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.cooperative.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>VoitureServlet</servlet-name>
        <servlet-class>com.cooperative.servlet.VoitureServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>
    <!-- AJOUTEZ CES LIGNES ICI -->
    <welcome-file-list>
        <welcome-file>dashboard</welcome-file>
    </welcome-file-list>
    <servlet-mapping>
        <servlet-name>VoitureServlet</servlet-name>
        <url-pattern>/VoitureServlet</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
